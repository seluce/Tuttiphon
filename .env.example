# Tuttiphon – credentials. Belongs in the data folder as .env (in the container: /config/.env; on a PC: data/.env).
# Easiest: enter everything in the interface (Settings → Navidrome) – it writes this file.
# Values set in docker-compose.yaml take precedence and cannot be changed in the interface.

# Password of the local administrator (turns on sign-in) – usually set in docker-compose.yaml instead
#TUTTIPHON_ADMIN_PASSWORD=

#NAV_URL=http://192.168.1.10:4533
#NAV_ADMIN_USER=admin
#NAV_ADMIN_PASS=

# Passwords of the Navidrome users whose ratings and plays Tuttiphon reads (stars, statistics, taste), one line per
# account: NAV_PASS_<ACCOUNT IN CAPITALS>. Each person can also enter their own at sign-in.
#NAV_PASS_ALEX=
#NAV_PASS_MIA=

# Optional: Last.fm key (similar bands, tags) and the access token of a protected ntfy server (notifications)
#LASTFM_API_KEY=
#NTFY_TOKEN=
