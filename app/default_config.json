    "hitsShare": 0.3,
    "autoApply": true,
    "dailyMode": "playlists",
    "dailyAt": "05:30",
    "pipeline": [
      "flac",
      "lyrics",
      "cover",
      "analyse",
      "playlists",
      "scan",
      "deezer"
    ],
    "start": {
      "sections": [
        {
          "id": "heute",
          "on": true
        },
        {
          "id": "todo",
          "on": true
        },
        {
          "id": "woche",
          "on": true
        },
        {
          "id": "neu",
          "on": true
        },
        {
          "id": "playlists",
          "on": true
        },
        {
          "id": "karten",
          "on": true
        },
        {
          "id": "verlauf",
          "on": true
        }
      ],
      "showSteps": true
    },
    "navidrome": {
      "scan": "quick"
    },
    "deezer": {
      "thresholds": [
        10000,
        100000,
        300000,
        600000,
        850000
      ],
      "users": null,
      "overwriteManual": false,
      "pipelineMode": "new",
      "rate": 9
    },
    "lyrics": {
      "cleanup": true,
      "fetch": true,
      "savePlain": true,
      "instrumental": "mark",
      "retryDays": 30,
      "workers": 6,
      "upgradePlain": true,
      "providers": [
        {
          "id": "lrclib",
          "on": true
        },
        {
          "id": "netease",
          "on": false
        }
      ],
      "budgetMinutes": 5
    },
    "opus": {
      "enabled": false,
      "bitrate": 160,
      "formats": [
        "flac"
      ],
      "original": "archive",
      "archiveDir": "Archiv",
      "minAgeMinutes": 10,
      "owner": "",
      "jobs": 1
    },
    "paths": {
      "music": "",
      "playlists": "",
      "archive": ""
    },
    "watch": {
      "enabled": false,
      "interval": 15,
      "convert": true,
      "lyrics": true,
      "deezer": true
    },
    "analysis": {
      "enabled": true,
      "depth": "standard",
      "budgetMinutes": 10,
      "workers": 0,
      "lastfmBudget": 3,
      "classify": "suggest",
      "autoThreshold": 0.75,
      "autoNew": true,
      "ml": true,
      "mlBudget": 15,
      "mlThreads": 2,
      "fingerprints": true,
      "night": {
        "enabled": true,
        "from": "01:00",
        "to": "05:00"
      }
    },
    "backup": {
      "enabled": true,
      "keep": 14,
      "dir": ""
    },
    "mixLearn": true,
    "smoothTransitions": true,
    "kinderschutz": {
      "allow": []
    },
    "notify": {
      "enabled": false,
      "server": "https://ntfy.sh",
      "topic": "",
      "url": "",
      "events": {
        "failed": true,
        "newMusic": true,
        "autoAssigned": true,
        "favorites": true,
        "review": true,
        "weekly": true
      }
    },
    "welten": {
      "auto": true
    },
    "loudness": {
      "enabled": false,
      "album": true
    },
    "covers": {
      "enabled": true
    },
    "seasonRest": true,
    "setup": {
      "done": false
    }
