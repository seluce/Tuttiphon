{
  "name": "tuttiphon",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Tuttiphon interface: Svelte 5 + Vite + Tailwind 4. 'npm run build' builds frontend/ into web/, which the Python server serves. web/ is generated and does not belong in Git.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test:e2e": "playwright test",
    "test:py": "python3 -m unittest discover -s tests/python -t .",
    "test:i18n": "node tools/i18n-check.mjs && python3 tools/i18n_check.py",
    "release": "bash tools/release.sh",
    "release:with-data": "bash tools/release.sh --with-data"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.51.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  }
}
